---
export const prerender=true;
import 'maplibre-gl/dist/maplibre-gl.css';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
// Map layers (map.ts, "Layers"). Icons: a windsock on its pole, a round lens on a stand, a snowflake, waves.
const layers=[
  {id:'wind',name:'Veter',title:'Veter',path:'<path d="M4 21V3M4 4l17 3.5v3L4 12M9.5 5.1v5.8M15 6.3v3.4"/>'},
  {id:'cameras',name:'Kamere',title:'Spletne kamere',path:'<circle cx="12" cy="10" r="7"/><circle cx="12" cy="10" r="2.5"/><path d="M9 16.5 7 21h10l-2-4.5"/>'},
  {id:'snow',name:'Sneg',title:'Padavine in sneg',path:'<path d="M2 12h20M12 2v20M20 16l-4-4 4-4M4 8l4 4-4 4M16 4l-4 4-4-4M8 20l4-4 4 4"/>'},
  {id:'rivers',name:'Reke',title:'Pretoki rek',path:'<path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>'},
];
---
<Layout page="Zemljevid" full>
  <!-- Start the basemap downloads while the page script still loads: fetch the style now and open the
       connections to the tile, font and icon servers (crossorigin, as MapLibre fetches them with CORS). -->
  <Fragment slot="head">
    <link rel="preload" href="https://styles.maptoolkit.org/hiking.json" as="fetch" crossorigin />
    <link rel="preconnect" href="https://tiles.maptoolkit.org" crossorigin />
    <link rel="preconnect" href="https://tiles.mapterhorn.com" crossorigin />
    <link rel="preconnect" href="https://fonts.maptoolkit.org" crossorigin />
    <link rel="preconnect" href="https://icons.maptoolkit.org" crossorigin />
  </Fragment>
  <!-- Header bar with the logo. On phones its search button opens the search box below it (data-search on
       #map-page); on desktop the box is always shown, top left. -->
  <div id="map-page" class="group contents">
  <Header page="Zemljevid" class="absolute inset-x-0 top-0 z-[700] shadow-md">
    <button id="search-toggle" type="button" aria-expanded="false" aria-controls="search-box" class="grid size-10 place-items-center rounded-lg text-white/90 hover:bg-white/10 hover:text-white md:hidden" aria-label="Išči postajo" title="Išči postajo"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg></button>
  </Header>
  <!-- Phones, from the bottom edge up: the Maptoolkit logo and the map credit (0–33 px); then the time slider
       (40–84 px, once shown) with the zoom buttons right of it (40–128 px; a gap above the credit lifts them); the
       layer column above the zoom buttons (from 136 px). On desktop the slider and layer bar are in the middle,
       clear of the corners. Control buttons are 44 px (finger size)
       instead of MapLibre's 29 px, with bigger icons. The markers' z-indexes stay inside their own container
       (isolate), so arrows never draw over the map controls. -->
  <div class="absolute inset-0 z-0"><div id="map" class="h-full w-full [&_.maplibregl-canvas-container]:isolate max-md:[&_.maplibregl-ctrl-attrib]:mt-[10px]! [&_.maplibregl-ctrl-group_button]:size-11! [&_.maplibregl-ctrl-group]:rounded-xl! [&_.maplibregl-ctrl-zoom-in_.maplibregl-ctrl-icon]:bg-[length:36px]! [&_.maplibregl-ctrl-zoom-out_.maplibregl-ctrl-icon]:bg-[length:36px]!" role="application" aria-label="Zemljevid postaj"></div></div>
  <!-- Search box with its results below. -->
  <div id="search-box" class="absolute inset-x-2 top-16 z-[650] flex flex-col gap-1 max-md:hidden max-md:group-data-[search]:flex md:right-auto md:w-80">
    <div class="flex rounded-xl bg-white shadow-md">
      <label for="site-search" class="sr-only">Išči postajo</label>
      <input id="site-search" type="search" placeholder="Išči postajo…" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" class="min-h-11 min-w-0 flex-1 rounded-xl bg-transparent px-3 text-base outline-none focus-visible:ring-2 focus-visible:ring-brand md:text-sm" />
    </div>
    <ul id="search-results" role="listbox" aria-label="Zadetki" hidden class="max-h-[50dvh] overflow-y-auto rounded-xl bg-white py-1 shadow-md md:max-h-80"></ul>
  </div>
  <!-- Bottom: status and the time slider; on desktop above the layer bar. -->
  <div class="absolute inset-x-2 bottom-10 z-[600] mx-auto flex max-w-md flex-col gap-2 max-md:right-[62px] md:bottom-24">
    <p id="map-status" role="status" class="mx-auto w-fit rounded bg-white/90 px-2 py-1 text-xs text-zinc-600 empty:hidden">Nalaganje…</p>
    <!-- Time slider: arrows at an earlier time (the last few hours); hidden until there is history. See "Time slider" in map.ts. -->
    <div id="time" hidden class="flex items-center gap-1 rounded-xl bg-white pr-3 shadow-md">
      <button id="time-play" type="button" aria-pressed="false" class="grid size-11 shrink-0 place-items-center rounded-xl text-brand hover:text-brand-dark" aria-label="Predvajaj zadnje ure" title="Predvajaj zadnje ure"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></button>
      <input id="time-slider" type="range" min="-180" max="0" step="10" value="0" aria-label="Čas na zemljevidu" class="min-w-0 flex-1 accent-brand" />
      <output id="time-label" for="time-slider" class="w-24 shrink-0 text-right text-xs text-zinc-600 tabular-nums">zdaj</output>
    </div>
  </div>
  <!-- Layer bar: one layer at a time (map.ts, "Layers"). Phones: icons only, in a column above the zoom buttons,
       in the same 44 px box style. Desktop: a row with names at the bottom, in the middle. -->
  <nav id="layers" aria-label="Sloji" class="absolute z-[600] flex bg-white max-md:right-[10px] max-md:bottom-[136px] max-md:w-11 max-md:flex-col max-md:divide-y max-md:divide-zinc-200 max-md:overflow-hidden max-md:rounded-xl max-md:ring-2 max-md:ring-black/10 md:bottom-6 md:left-1/2 md:w-full md:max-w-md md:-translate-x-1/2 md:gap-1 md:rounded-2xl md:p-1.5 md:shadow-lg">
    {layers.map(({id,name,title,path})=><button type="button" data-layer={id} aria-pressed="false" title={title} class="flex size-11 items-center justify-center text-xs font-medium text-zinc-600 hover:text-zinc-900 aria-pressed:bg-brand aria-pressed:text-white md:h-auto md:w-auto md:flex-1 md:flex-col md:gap-0.5 md:rounded-xl md:py-1.5">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={path}></svg><span class="max-md:sr-only">{name}</span></button>)}
  </nav>
  <!-- Panel for whatever was tapped (a station, webcam or snow station): bottom sheet on phones (slides up); on
       desktop map.ts moves it into a bubble above the marker. Closed = invisible, faded and moved off (phones) or
       hidden (desktop); see setPanel in map.ts. -->
  <aside id="site" tabindex="-1" aria-labelledby="site-name" class="invisible opacity-0 max-md:translate-y-full md:hidden transition-all duration-300 ease-out motion-reduce:transition-none outline-none z-[1000] overflow-y-auto bg-white px-3 pb-6 max-md:absolute max-md:inset-x-0 max-md:bottom-0 max-md:max-h-[70%] max-md:rounded-t-2xl max-md:shadow-[0_-4px_16px_rgb(0_0_0/0.15)] md:max-h-[60vh] md:w-[560px] md:rounded-xl md:pb-4">
    <div class="sticky top-0 z-10 -mx-3 flex items-start justify-between gap-2 border-b border-zinc-200 bg-white px-3 pt-3 pb-2">
      <div class="min-w-0">
        <h2 id="site-name" class="text-lg leading-snug font-semibold break-words"></h2>
        <p id="site-meta" class="text-[10px] text-zinc-500"></p>
      </div>
      <div class="flex shrink-0">
      <!-- Share: the phone's share menu, or copy the link on desktop. -->
      <button id="site-share" type="button" class="grid size-11 shrink-0 place-items-center rounded-full text-zinc-600 hover:bg-zinc-100 hover:text-black" aria-label="Deli povezavo" title="Deli povezavo"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/></svg></button>
      <span id="site-share-status" role="status" class="sr-only"></span>
      <button id="site-close" type="button" class="grid size-11 shrink-0 place-items-center rounded-full text-zinc-600 hover:bg-zinc-100 hover:text-black" aria-label="Zapri"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>
    </div>
    <!-- Webcam images or snow readings (map.ts, openCard). -->
    <div id="site-card" hidden></div>
    <div id="site-wind">
    <section aria-label="Veter" class="pt-3">
      <p id="site-history-status" role="status" class="mb-2 text-xs text-zinc-500 empty:hidden"></p>
      <output id="site-reading" for="site-charts" class="mb-3 block text-base tabular-nums"></output>
      <!-- Hover (or tap) the graph to read a moment; ← → Home End when focused. -->
      <div id="site-charts" tabindex="0" aria-label="Zgodovina vetra; s puščicama izberete meritev" class="touch-pan-y rounded outline-none focus-visible:ring-2 focus-visible:ring-brand"></div>
    </section>
    <!-- vetr.si stations: wind rose of the last hour; see loadRose in map.ts. -->
    <section id="site-rose" hidden aria-label="Vetrna roža" class="mt-4 border-t border-zinc-200 pt-3"></section>
    <!-- Thanks to the station's data source, in that source's own look; map.ts shows the block for the
         selected station's source (data-source). -->
    <section id="site-thanks" aria-label="Vir podatkov" class="mt-4 border-t border-zinc-200 pt-3">
      <div data-source="skytech" hidden>
        <h3 class="mb-2 text-xs text-zinc-500">Podatki od:</h3>
        <div class="grid grid-cols-2 gap-2">
          <!-- skytech.si header: white wordmark on its blue sky gradient with clouds. -->
          <a href="https://skytech.si/" target="_blank" rel="noopener" class="flex h-24 items-center justify-center rounded bg-[image:url(/logos/skytech-glare.png),linear-gradient(to_bottom,#0670C6,#088BF7_60%,#52AEFA)] bg-cover bg-no-repeat hover:brightness-110"><img src="/logos/skytech.png" alt="Skytech vremenske postaje" width="300" height="150" class="h-24 w-auto"></a>
          <!-- KOK makes the Skytech stations and runs skytech.si ("Upravitelj spletne strani"); its banner from there. -->
          <a href="https://www.kok.si/" target="_blank" rel="noopener" class="flex h-24 items-center justify-center overflow-hidden rounded border border-zinc-200 bg-white hover:opacity-90"><img src="/logos/kok.png" alt="KOK, proizvodnja elektronskih naprav" width="300" height="108" class="h-auto max-h-full w-full object-contain"></a>
        </div>
      </div>
      <div data-source="arso" hidden>
        <h3 class="mb-2 text-xs text-zinc-500">Podatki od:</h3>
        <!-- As in the ARSO METEO header bar. -->
        <a href="https://meteo.arso.gov.si/" target="_blank" rel="noopener" class="flex h-16 items-center justify-center rounded bg-[#509ab8] hover:bg-[#6eacc4]"><img src="/logos/arso-meteo.svg" alt="ARSO meteo" class="h-6"></a>
      </div>
      <div data-source="vetr" hidden>
        <h3 class="mb-2 text-xs text-zinc-500">Podatki od:</h3>
        <div class="grid grid-cols-2 gap-2">
          <!-- vetr.si header: title and subtitle on its sky-to-indigo gradient. -->
          <a href="https://vetr.si/" target="_blank" rel="noopener" class="flex h-24 flex-col items-center justify-center rounded bg-indigo-50 bg-linear-to-b from-sky-200/70 via-indigo-100/40 to-indigo-50 text-center hover:from-sky-200">
            <span class="font-sans text-3xl font-bold text-sky-700">vetr.si</span>
            <span class="text-[10px] font-medium tracking-[0.18em] text-sky-500 uppercase">Paragliding wind stations</span>
          </a>
          <!-- to-ni.dev navigation bar. -->
          <a href="https://to-ni.dev/" target="_blank" rel="noopener" class="flex h-24 items-center justify-center rounded border border-slate-800 bg-slate-950 hover:bg-slate-900">
            <span class="font-sans text-2xl font-bold text-cyan-400">to-ni.dev</span>
          </a>
        </div>
      </div>
      <div data-source="luftar" hidden>
        <h3 class="mb-2 text-xs text-zinc-500">Podatki od:</h3>
        <a href="https://www.luftar.si/" target="_blank" rel="noopener" class="block overflow-hidden rounded hover:opacity-90"><img src="/logos/luftar.svg" alt="KJP Luftar" width="980" height="400" class="h-auto w-full"></a>
      </div>
    </section>
    </div>
  </aside>
  </div>
  <script src="../scripts/map.ts"></script>
</Layout>
