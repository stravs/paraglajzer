---
export const prerender=true;
import 'maplibre-gl/dist/maplibre-gl.css';
import Layout from '../layouts/Layout.astro';
---
<Layout page="Zemljevid" full>
  <!-- Start the basemap downloads while the page script still loads: fetch the style now and open the
       connections to the tile, font and icon servers (crossorigin, as MapLibre fetches them with CORS). -->
  <Fragment slot="head">
    <link rel="preload" href="https://styles.maptoolkit.org/hiking.json" as="fetch" crossorigin />
    <link rel="preconnect" href="https://tiles.maptoolkit.org" crossorigin />
    <link rel="preconnect" href="https://tiles.mapterhorn.com" crossorigin />
    <link rel="preconnect" href="https://fonts.maptoolkit.org" crossorigin />
    <link rel="preconnect" href="https://icons.maptoolkit.org" crossorigin />
  </Fragment>
  <!-- Header bar. On phones it hides on the first map move by the user (map.ts removes data-header);
       on desktop it stays, with the search box and site panel below it. -->
  <div id="map-page" data-header class="group contents">
  <header class="absolute inset-x-0 top-0 z-[700] flex h-12 items-center justify-center border-b border-zinc-200 bg-white px-3 shadow-sm transition-all duration-300 ease-out motion-reduce:transition-none max-md:invisible max-md:-translate-y-full max-md:opacity-0 group-data-[header]:visible group-data-[header]:translate-y-0 group-data-[header]:opacity-100">
    <p class="text-base font-semibold">Agregator veternih postaj</p>
  </header>
  <!-- On phones the search bar (and the time slider, once shown) are at the bottom, so the map's bottom controls move up above them. Control buttons are
       44 px (finger size) instead of MapLibre's 29 px, with bigger icons. The markers' z-indexes stay inside
       their own container (isolate), so arrows never draw over the map controls. -->
  <div class="absolute inset-0 z-0"><div id="map" class="h-full w-full [&_.maplibregl-canvas-container]:isolate max-md:[&_.maplibregl-ctrl-bottom-right]:mb-14 max-md:[&_.maplibregl-ctrl-bottom-left]:mb-14 max-md:group-has-[#time:not([hidden])]:[&_.maplibregl-ctrl-bottom-right]:mb-26 max-md:group-has-[#time:not([hidden])]:[&_.maplibregl-ctrl-bottom-left]:mb-26 [&_.maplibregl-ctrl-group_button]:size-11! [&_.maplibregl-ctrl-group]:rounded-lg! [&_.maplibregl-ctrl-zoom-in_.maplibregl-ctrl-icon]:bg-[length:36px]! [&_.maplibregl-ctrl-zoom-out_.maplibregl-ctrl-icon]:bg-[length:36px]!" role="application" aria-label="Zemljevid postaj"></div></div>
  <!-- Phones: at the bottom, results open upwards (column reversed). Desktop: top left, results below. -->
  <div class="absolute inset-x-2 bottom-2 z-[600] flex flex-col-reverse gap-1 md:top-14 md:right-auto md:bottom-auto md:w-80 md:flex-col">
    <!-- Search box and a separate Napoved button beside it. -->
    <div class="flex items-center gap-2">
      <div class="flex min-w-0 flex-1 rounded-lg bg-white shadow-md">
        <label for="site-search" class="sr-only">Išči postajo</label>
        <input id="site-search" type="search" placeholder="Išči postajo…" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" class="min-h-11 min-w-0 flex-1 rounded-lg bg-transparent px-3 text-base outline-none md:text-sm" />
      </div>
      <nav aria-label="Strani" class="shrink-0">
        <a href="/napoved/" class="flex min-h-11 items-center rounded-lg bg-white px-3 text-sm font-medium text-zinc-700 shadow-md hover:text-black">Napoved</a>
      </nav>
    </div>
    <ul id="search-results" role="listbox" aria-label="Zadetki" hidden class="max-h-[50dvh] overflow-y-auto rounded-lg bg-white py-1 shadow-md max-md:flex-col-reverse max-md:[&:not([hidden])]:flex md:max-h-80"></ul>
    <p id="map-status" role="status" class="w-fit rounded bg-white/90 px-2 py-1 text-xs text-zinc-600 empty:hidden">Nalaganje…</p>
    <!-- Time slider: arrows at an earlier time (the last few hours); hidden until there is history. See "Time slider" in map.ts. -->
    <div id="time" hidden class="flex items-center gap-1 rounded-lg bg-white pr-3 shadow-md">
      <button id="time-play" type="button" aria-pressed="false" class="grid size-11 shrink-0 place-items-center rounded-lg text-zinc-700 hover:text-black" aria-label="Predvajaj zadnje ure" title="Predvajaj zadnje ure"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></button>
      <input id="time-slider" type="range" min="-180" max="0" step="10" value="0" aria-label="Čas na zemljevidu" class="min-w-0 flex-1 accent-blue-600" />
      <output id="time-label" for="time-slider" class="w-24 shrink-0 text-right text-xs text-zinc-600 tabular-nums">zdaj</output>
    </div>
  </div>
  <!-- Site panel: bottom sheet on phones (slides up); on desktop a card at the top right, only as tall as its
       content (slides in from the right). Closed = invisible, faded and moved off; see setPanel in map.ts. -->
  <aside id="site" tabindex="-1" aria-labelledby="site-name" class="invisible opacity-0 max-md:translate-y-full md:translate-x-8 transition-all duration-300 ease-out motion-reduce:transition-none outline-none absolute inset-x-0 bottom-0 z-[1000] max-h-[70%] overflow-y-auto border-t border-zinc-300 bg-white px-3 pb-6 shadow-lg md:top-14 md:right-2 md:bottom-auto md:left-auto md:max-h-[calc(100%-4rem)] md:w-[560px] md:rounded-lg md:border md:border-zinc-200 md:pb-4">
    <div class="sticky top-0 z-10 -mx-3 flex items-start justify-between gap-2 border-b border-zinc-200 bg-white px-3 py-2">
      <div class="min-w-0">
        <h2 id="site-name" class="text-lg leading-snug font-semibold break-words"></h2>
        <p id="site-meta" class="text-[10px] text-zinc-500"></p>
      </div>
      <div class="flex shrink-0">
      <!-- Share: the phone's share menu, or copy the link on desktop. -->
      <button id="site-share" type="button" class="grid size-11 shrink-0 place-items-center rounded-full text-zinc-600 hover:bg-zinc-100 hover:text-black" aria-label="Deli povezavo" title="Deli povezavo"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/></svg></button>
      <span id="site-share-status" role="status" class="sr-only"></span>
      <button id="site-close" type="button" class="grid size-11 shrink-0 place-items-center rounded-full text-zinc-600 hover:bg-zinc-100 hover:text-black" aria-label="Zapri"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>
    </div>
    <section aria-label="Veter" class="pt-3">
      <p id="site-history-status" role="status" class="mb-2 text-xs text-zinc-500 empty:hidden"></p>
      <output id="site-reading" for="site-charts" class="mb-3 block text-base tabular-nums"></output>
      <!-- Hover (or tap) the graph to read a moment; ← → Home End when focused. -->
      <div id="site-charts" tabindex="0" aria-label="Zgodovina vetra; s puščicama izberete meritev" class="touch-pan-y rounded outline-none focus-visible:ring-2 focus-visible:ring-blue-600"></div>
    </section>
    <!-- vetr.si stations: wind rose of the last hour; see loadRose in map.ts. -->
    <section id="site-rose" hidden aria-label="Vetrna roža" class="mt-4 border-t border-zinc-200 pt-3"></section>
    <!-- Thanks to the station's data source, in that source's own look; map.ts shows the block for the
         selected station's source (data-source). -->
    <section id="site-thanks" aria-label="Vir podatkov" class="mt-4 border-t border-zinc-200 pt-3">
      <div data-source="skytech" hidden>
        <h3 class="mb-2 text-xs text-zinc-500">Podatki od:</h3>
        <div class="grid grid-cols-2 gap-2">
          <!-- skytech.si header: white wordmark on its blue sky gradient with clouds. -->
          <a href="https://skytech.si/" target="_blank" rel="noopener" class="flex h-24 items-center justify-center rounded bg-[image:url(/logos/skytech-glare.png),linear-gradient(to_bottom,#0670C6,#088BF7_60%,#52AEFA)] bg-cover bg-no-repeat hover:brightness-110"><img src="/logos/skytech.png" alt="Skytech vremenske postaje" width="300" height="150" class="h-24 w-auto"></a>
          <!-- KOK makes the Skytech stations and runs skytech.si ("Upravitelj spletne strani"); its banner from there. -->
          <a href="https://www.kok.si/" target="_blank" rel="noopener" class="flex h-24 items-center justify-center overflow-hidden rounded border border-zinc-200 bg-white hover:opacity-90"><img src="/logos/kok.png" alt="KOK, proizvodnja elektronskih naprav" width="300" height="108" class="h-auto max-h-full w-full object-contain"></a>
        </div>
      </div>
      <div data-source="arso" hidden>
        <h3 class="mb-2 text-xs text-zinc-500">Podatki od:</h3>
        <!-- As in the ARSO METEO header bar. -->
        <a href="https://meteo.arso.gov.si/" target="_blank" rel="noopener" class="flex h-16 items-center justify-center rounded bg-[#509ab8] hover:bg-[#6eacc4]"><img src="/logos/arso-meteo.svg" alt="ARSO meteo" class="h-6"></a>
      </div>
      <div data-source="vetr" hidden>
        <h3 class="mb-2 text-xs text-zinc-500">Podatki od:</h3>
        <div class="grid grid-cols-2 gap-2">
          <!-- vetr.si header: title and subtitle on its sky-to-indigo gradient. -->
          <a href="https://vetr.si/" target="_blank" rel="noopener" class="flex h-24 flex-col items-center justify-center rounded bg-indigo-50 bg-linear-to-b from-sky-200/70 via-indigo-100/40 to-indigo-50 text-center hover:from-sky-200">
            <span class="font-sans text-3xl font-bold text-sky-700">vetr.si</span>
            <span class="text-[10px] font-medium tracking-[0.18em] text-sky-500 uppercase">Paragliding wind stations</span>
          </a>
          <!-- to-ni.dev navigation bar. -->
          <a href="https://to-ni.dev/" target="_blank" rel="noopener" class="flex h-24 items-center justify-center rounded border border-slate-800 bg-slate-950 hover:bg-slate-900">
            <span class="font-sans text-2xl font-bold text-cyan-400">to-ni.dev</span>
          </a>
        </div>
      </div>
      <div data-source="luftar" hidden>
        <h3 class="mb-2 text-xs text-zinc-500">Podatki od:</h3>
        <a href="https://www.luftar.si/" target="_blank" rel="noopener" class="block overflow-hidden rounded hover:opacity-90"><img src="/logos/luftar.svg" alt="KJP Luftar" width="980" height="400" class="h-auto w-full"></a>
      </div>
    </section>
  </aside>
  </div>
  <script src="../scripts/map.ts"></script>
</Layout>
