---
export const prerender=true;
import Layout from '../layouts/Layout.astro';
import { chartRegions } from '../lib/jadralci';
import { regions,layers } from '../lib/sources';
---
<Layout page="Napoved">
  <section id="regional-charts" aria-label="Jadralci">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
      <select id="chart-region" aria-label="Regija Jadralci" class="min-h-10 max-w-full border border-zinc-300 bg-white px-2">{Object.entries(chartRegions).map(([id,name])=><option value={id}>{name}</option>)}</select>
      <span id="regional-meta" class="text-xs text-zinc-500" role="status"></span>
    </div>
    <div id="regional-images" class="grid gap-4 md:grid-cols-2" aria-busy="true"></div>
  </section>
  <section class="mt-6 border-t border-zinc-200 pt-4" aria-labelledby="thermal-title">
    <div class="mb-2 flex items-center justify-between gap-2"><h2 id="thermal-title" class="font-medium">Termika · RSS</h2><select id="thermal-region" aria-label="Regija termike" class="min-h-10 border border-zinc-300 bg-white px-2">{Object.entries(regions).map(([id,name])=><option value={id}>{name}</option>)}</select></div>
    <div id="thermals" class="text-sm" aria-live="polite"></div><p id="thermal-meta" class="mt-2 text-xs text-zinc-500"></p>
  </section>
  <section id="forecast" class="mt-6 border-t border-zinc-200 pt-4" aria-labelledby="forecast-title">
    <div class="mb-2 flex items-center justify-between gap-2"><h2 id="forecast-title" class="font-medium">ALADIN · Zaladin</h2><select id="layer" aria-label="Sloj napovedi" class="min-h-10 max-w-[65%] border border-zinc-300 bg-white px-2">{Object.entries(layers).map(([id,name])=><option value={id} selected={id==='2'}>{name}</option>)}</select></div>
    <p id="map-placeholder" class="py-6 text-zinc-500">Nalaganje…</p>
    <a id="map-original" href="https://zaladin.razor.si/" target="_blank" rel="noopener noreferrer"><img id="forecast-image" hidden class="mx-auto h-auto w-full max-w-[740px]" alt="Napoved ALADIN" /></a>
    <div class="mt-2 flex flex-wrap justify-between gap-2 text-xs"><span id="map-time"></span><span id="map-meta" class="text-zinc-500"></span></div>
    <input id="forecast-step" type="range" min="0" max="0" value="0" disabled aria-label="Čas napovedi" class="mt-2 min-h-10 w-full accent-zinc-700" />
  </section>
  <section class="mt-4 border-t border-zinc-200" aria-label="Dodatni podatki ARSO">
    <details id="aviation-detail" class="border-b border-zinc-200 py-3"><summary class="cursor-pointer">Besedilna napoved</summary><pre id="aviation-text" class="mt-3 whitespace-pre-wrap font-mono text-xs leading-6"></pre></details>
    <details id="sounding-detail" class="border-b border-zinc-200 py-3"><summary class="cursor-pointer">Sondaža · Ljubljana</summary><div id="sounding-image" class="mt-3"></div></details>
    <details id="radar-detail" class="border-b border-zinc-200 py-3"><summary class="cursor-pointer">Radar padavin</summary><div id="radar-image" class="mt-3"></div></details>
    <a class="inline-block py-3 text-xs text-zinc-500 underline" href="https://meteo.arso.gov.si/met/sl/aviation/" target="_blank" rel="noopener noreferrer">ARSO · opozorila in letalstvo</a>
  </section>
  <script src="../scripts/forecast.ts"></script>
</Layout>
