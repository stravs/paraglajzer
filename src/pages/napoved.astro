---
export const prerender=true;
import Layout from '../layouts/Layout.astro';
import { chartRegions } from '../lib/jadralci';
import { layers } from '../lib/sources';
---
<Layout page="Napoved">
  <section id="regional-charts" aria-label="Jadralci">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
      <select id="chart-region" aria-label="Regija" class="min-h-10 max-w-full border border-zinc-300 bg-white px-2">{Object.entries(chartRegions).map(([id,name])=><option value={id}>{name}</option>)}</select>
      <span id="regional-meta" class="text-xs text-zinc-500" role="status"></span>
    </div>
    <!-- ARSO thermal forecast for the chosen region, above the charts; days side by side. -->
    <section class="mb-4 border-b border-zinc-200 pb-3" aria-labelledby="thermal-title">
      <h2 id="thermal-title" class="mb-1 text-sm font-medium">Termika · <span id="thermal-region-name">Gorenjska</span></h2>
      <div id="thermals" class="grid grid-cols-2 gap-x-4 text-sm" aria-live="polite"></div><p id="thermal-meta" class="mt-1 text-xs text-zinc-500"></p>
    </section>
    <!-- Phones: one chart at a time, swiped sideways (scroll snapping), with dots below. Wider screens: a 2-column grid. -->
    <div id="regional-images" class="flex snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain [scrollbar-width:none] md:grid md:grid-cols-2 md:overflow-visible" aria-busy="true"></div>
    <div id="regional-dots" class="mt-2 flex justify-center gap-1 md:hidden" aria-hidden="true"></div>
  </section>
  <section id="forecast" class="mt-6 border-t border-zinc-200 pt-4" aria-labelledby="forecast-title">
    <div class="mb-2 flex items-center justify-between gap-2"><h2 id="forecast-title" class="font-medium">ALADIN · Zaladin</h2><select id="layer" aria-label="Sloj napovedi" class="min-h-10 max-w-[65%] border border-zinc-300 bg-white px-2">{Object.entries(layers).map(([id,name])=><option value={id} selected={id==='2'}>{name}</option>)}</select></div>
    <p id="map-placeholder" class="py-6 text-zinc-500">Nalaganje…</p>
    <!-- Frame viewer: arrows on each side, horizontal swipe on touch screens (vertical scroll still works). -->
    <div id="forecast-viewer" class="relative mx-auto max-w-[740px] touch-pan-y">
      <img id="forecast-image" hidden class="h-auto w-full transition-opacity" alt="Napoved ALADIN" />
      <button id="frame-prev" type="button" aria-label="Prejšnja napoved" disabled class="absolute top-1/2 left-2 grid size-14 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-zinc-900 shadow-lg ring-1 ring-black/10 hover:bg-white active:scale-95 disabled:invisible"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
      <button id="frame-next" type="button" aria-label="Naslednja napoved" disabled class="absolute top-1/2 right-2 grid size-14 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-zinc-900 shadow-lg ring-1 ring-black/10 hover:bg-white active:scale-95 disabled:invisible"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>
    <div class="mx-auto max-w-[740px]">
      <p class="mt-2 flex flex-wrap items-baseline justify-between gap-x-2"><span id="map-time" class="text-base font-semibold"></span><span id="map-position" class="text-xs text-zinc-500"></span></p>
      <input id="forecast-step" type="range" min="0" max="0" value="0" disabled aria-label="Čas napovedi" class="mt-1 min-h-10 w-full accent-zinc-700" />
      <p id="map-run" class="text-xs text-zinc-500"></p>
      <p id="map-meta" class="text-xs text-amber-700 empty:hidden"></p>
    </div>
  </section>
  <section class="mt-6 border-t border-zinc-200 pt-4" aria-labelledby="aviation-title">
    <h2 id="aviation-title" class="mb-2 font-medium">Besedilna napoved</h2>
    <pre id="aviation-text" class="whitespace-pre-wrap font-mono text-xs leading-6 text-zinc-500">Nalaganje…</pre>
  </section>
  <section class="mt-6 border-t border-zinc-200 pt-4" aria-labelledby="radar-title">
    <h2 id="radar-title" class="mb-2 font-medium">Radar padavin</h2>
    <div id="radar-image" class="text-xs text-zinc-500">Nalaganje…</div>
  </section>
  <section class="mt-4 border-t border-zinc-200" aria-label="Povezave ARSO">
    <a class="inline-block py-3 text-xs text-zinc-500 underline" href="https://meteo.arso.gov.si/met/sl/aviation/" target="_blank" rel="noopener noreferrer">ARSO · opozorila in letalstvo</a>
  </section>
  <script src="../scripts/forecast.ts"></script>
</Layout>
