{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "paraglajzer",
	"main": "./src/worker.ts",
	"durable_objects": { "bindings": [{ "name": "SOURCES", "class_name": "SourceCache" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SourceCache"] }],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// /vetr/ is password-protected, so the Worker checks it before the static page is served.
		"run_worker_first": ["/vetr", "/vetr/*"]
	},
	"observability": {
		"enabled": true
	}
}